namespace JogoDaVelha
{
    internal class Program
    {
        static void Main(string[] args)
        {
            string[,] matriz = new string[3, 3] { { "", "", "" }, { "", "", "" }, { "", "", "" } };

            bool winner = false;
            int count = 0;

            while (winner == false && count < 9)
            {
                for (int i = 0; i < 3; i++)
                {
                    for (int j = 0; j < 3; j++)
                    {
                        Console.Write("[" + (matriz[i, j] == "" ? " " : matriz[i, j]) + "]");
                    }
                    Console.WriteLine();
                }

                string player = (count % 2 == 0) ? "X" : "O";
                Console.WriteLine($"Jogador {player}, digite a linha (1-3) e coluna (1-3): ");
                int line = int.Parse(Console.ReadLine()) - 1;
                int column = int.Parse(Console.ReadLine()) - 1;

                if (line < 0 || line > 2 || column < 0 || column > 2)
                {
                    Console.WriteLine("Posição inválida! Tente novamente.");
                    continue;
                }

                if (matriz[line, column] != "")
                {
                    Console.WriteLine("Posição já ocupada! Tente novamente.");
                    continue;
                }

                matriz[line, column] = player;
                count++;
            }

            // Imprimir tabuleiro final
            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 3; j++)
                {
                    Console.Write("[" + (matriz[i, j] == "" ? " " : matriz[i, j]) + "]");
                }
                Console.WriteLine();
            }

            Console.WriteLine("Fim do jogo!");
        }
            
    }
}
